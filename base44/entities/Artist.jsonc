{
  "name": "Artist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Artist Name"
    },
    "profile_image": {
      "type": "string",
      "title": "Profile Image URL"
    },
    "profile_image_from_provider": {
      "type": "string",
      "title": "Profile image source",
      "description": "upload, instagram, tiktok, youtube, facebook, or x — which connected account supplies the roster photo."
    },
    "biography": {
      "type": "string",
      "title": "Biography"
    },
    "genre": {
      "type": "string",
      "title": "Genre"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "website": {
      "type": "string",
      "title": "Website"
    },
    "spotify_url": {
      "type": "string",
      "title": "Spotify URL"
    },
    "youtube_url": {
      "type": "string",
      "title": "YouTube URL"
    },
    "tiktok_url": {
      "type": "string",
      "title": "TikTok URL"
    },
    "instagram_url": {
      "type": "string",
      "title": "Instagram URL"
    },
    "facebook_url": {
      "type": "string",
      "title": "Facebook URL"
    },
    "twitter_url": {
      "type": "string",
      "title": "X (Twitter) URL"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Is Demo Data"
    },
    "show_on_public_profile": {
      "type": "boolean",
      "default": true,
      "title": "Show on public profile",
      "description": "When your account profile is public, list this artist for community discovery."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}