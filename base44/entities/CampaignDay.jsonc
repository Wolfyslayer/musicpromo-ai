{
  "name": "CampaignDay",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "title": "Campaign ID"
    },
    "day_number": {
      "type": "number",
      "title": "Day Number"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "platform": {
      "type": "string",
      "title": "Platform"
    },
    "publish_platforms": {
      "type": "array",
      "title": "Publish platforms",
      "description": "Provider ids to auto-publish each day: instagram, tiktok, youtube, x",
      "items": { "type": "string" }
    },
    "content_type": {
      "type": "string",
      "title": "Content Type"
    },
    "objective": {
      "type": "string",
      "title": "Objective"
    },
    "video_concept": {
      "type": "string",
      "title": "Video Concept"
    },
    "hook": {
      "type": "string",
      "title": "Hook"
    },
    "caption": {
      "type": "string",
      "title": "Caption"
    },
    "hashtags": {
      "type": "string",
      "title": "Hashtags"
    },
    "cta": {
      "type": "string",
      "title": "Call to Action"
    },
    "video_template": {
      "type": "string",
      "title": "Recommended Video Template"
    },
    "posting_time": {
      "type": "string",
      "title": "Suggested Posting Time"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "title": "Scheduled Auto-Publish At"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "ready",
        "scheduled",
        "processing",
        "posted",
        "failed",
        "skipped",
        "pending",
        "complete"
      ],
      "default": "planned",
      "title": "Status"
    },
    "video_project_id": {
      "type": "string",
      "title": "Video Project ID"
    },
    "publish_error": {
      "type": "string",
      "title": "Auto-Publish Error"
    },
    "live_permalink": {
      "type": "string",
      "title": "Primary Live Permalink"
    }
  },
  "required": [
    "campaign_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    }
  }
}