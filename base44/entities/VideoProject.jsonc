{
  "name": "VideoProject",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "title": "Campaign ID"
    },
    "song_id": {
      "type": "string",
      "title": "Song ID"
    },
    "template": {
      "type": "string",
      "title": "Video Template"
    },
    "title": {
      "type": "string",
      "title": "Title Text"
    },
    "artist_name": {
      "type": "string",
      "title": "Artist Name"
    },
    "text": {
      "type": "string",
      "title": "Body Text"
    },
    "artwork_url": {
      "type": "string",
      "title": "Artwork URL"
    },
    "audio_url": {
      "type": "string",
      "title": "Audio URL"
    },
    "lyrics": {
      "type": "string",
      "title": "Lyrics"
    },
    "text_style": {
      "type": "string",
      "title": "Text Style"
    },
    "animation_style": {
      "type": "string",
      "title": "Animation Style"
    },
    "waveform": {
      "type": "boolean",
      "default": false,
      "title": "Show Waveform"
    },
    "duration": {
      "type": "number",
      "default": 15,
      "title": "Duration (seconds)"
    },
    "aspect_ratio": {
      "type": "string",
      "default": "9:16",
      "title": "Aspect Ratio"
    },
    "resolution": {
      "type": "string",
      "default": "1080x1920",
      "title": "Resolution"
    },
    "output_format": {
      "type": "string",
      "default": "mp4",
      "title": "Output Format"
    },
    "font_settings": {
      "type": "object",
      "title": "Font Settings"
    },
    "animation_settings": {
      "type": "object",
      "title": "Animation Settings"
    },
    "text_layers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Text Layers"
    },
    "rendering_status": {
      "type": "string",
      "enum": [
        "not_started",
        "queued",
        "rendering",
        "complete",
        "failed"
      ],
      "default": "not_started",
      "title": "Rendering Status"
    },
    "render_output_url": {
      "type": "string",
      "title": "Rendered Output URL"
    },
    "status": {
      "type": "string",
      "default": "draft",
      "title": "Status"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Is Demo Data"
    },
    "user_id": {
      "type": "string",
      "title": "Owner User ID"
    },
    "visual_style": {
      "type": "string",
      "enum": ["pop", "hiphop", "rock"],
      "default": "pop",
      "title": "Visual Style"
    },
    "particle_effect": {
      "type": "string",
      "enum": ["none", "stardust", "smoke", "sparks"],
      "default": "none",
      "title": "Particle Effect"
    },
    "editor_look": {
      "type": "object",
      "title": "Editor Look",
      "description": "Live typography, lyric position, and particle source settings."
    },
    "lyric_cues": {
      "type": "array",
      "title": "Lyric Cues",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "start": { "type": "number" },
          "end": { "type": "number" },
          "timeSeconds": { "type": "number" }
        }
      }
    },
    "compositing_mode": {
      "type": "string",
      "enum": ["artwork", "ai_blend", "ai_background"],
      "default": "artwork",
      "title": "How AI clips combine with artwork"
    },
    "ai_clip_url": {
      "type": "string",
      "title": "AI-generated motion clip (public MP4)"
    },
    "ai_clip_status": {
      "type": "string",
      "enum": ["none", "generating", "ready", "failed"],
      "title": "AI clip generation status"
    },
    "ai_clip_prompt": {
      "type": "string",
      "title": "Notes / concept for AI motion"
    },
    "ai_clip_opacity": {
      "type": "number",
      "title": "AI layer opacity (0.15–1)"
    },
    "artwork_motion": {
      "type": "string",
      "enum": ["standard", "cinematic", "hype"],
      "default": "standard",
      "title": "Free on-device cover motion mode"
    }
  },
  "required": [
    "song_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    }
  }
}