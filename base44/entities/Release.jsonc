{
  "name": "Release",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Release Title"
    },
    "artist_id": {
      "type": "string",
      "title": "Artist ID"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "title": "Release Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "released"
      ],
      "default": "draft",
      "title": "Status"
    },
    "artwork_url": {
      "type": "string",
      "title": "Artwork URL"
    },
    "presave_url": {
      "type": "string",
      "title": "Pre-save URL"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "genre": {
      "type": "string",
      "title": "Genre"
    },
    "language": {
      "type": "string",
      "title": "Language",
      "default": "English"
    },
    "release_type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album"
      ],
      "default": "single",
      "title": "Release type"
    },
    "primary_song_id": {
      "type": "string",
      "title": "Featured track (optional)"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "title": "Is Demo Data"
    }
  },
  "required": [
    "title",
    "artist_id"
  ],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
