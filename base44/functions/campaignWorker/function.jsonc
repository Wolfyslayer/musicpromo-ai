{
  "name": "campaignWorker",
  "entry": "entry.ts",
  // Cron runs without an end-user session; handler uses asServiceRole only.
  "authRequired": false,
  "access": "public",
  "permission": "user",
  "permissions": {
    "invoke": "public"
  }
  // NOTE: This app has Workflows enabled — legacy function.jsonc `automations`
  // are rejected (409 workflows_enabled). Create a Scheduled Workflow in the
  // Base44 Dashboard: invoke `campaignWorker` every 5–15 minutes (GitHub cron
  // also runs every 5 min when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY secrets
  // are set). Scheduling via campaignSchedule queues SocialPosts until
  // scheduled_at, then kicks the worker immediately when due.
}
