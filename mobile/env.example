EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Your deployed Vite web app (GitHub Pages, Base44 publish, etc.).
# Powers FREE mobile bridges — same client-side Remotion + Whisper as the browser:
#   /mobile-export-bridge
#   /mobile-lyrics-sync-bridge
EXPO_PUBLIC_WEB_APP_URL=https://your-production-domain.com

# Lyrics sync mode: `web` (default, free on-device Whisper via bridge) or `openai` (optional Edge Function, uses OPENAI_API_KEY)
EXPO_PUBLIC_LYRICS_SYNC=web
