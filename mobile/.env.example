# Prefer generating this file from the repo root:
#   npm run mobile:sync-env
# (maps VITE_* in .env.local → EXPO_PUBLIC_* below)
#
# Google OAuth needs a HOSTED Supabase project (Edge Functions). Local
# 127.0.0.1 Supabase cannot run registerGoogleOAuthPkce / googleAuthExchange.
# See docs/GOOGLE_SIGNIN.md § Local Expo testing.

# Mirror web VITE_SUPABASE_* — never commit real secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same Web OAuth client as web VITE_GOOGLE_CLIENT_ID (required for Google).
# Uses the existing Edge Functions: registerGoogleOAuthPkce + googleAuthExchange
# and the same redirect URI as the website.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Optional override (defaults to https://musicpromoai.site) — must match
# Google Cloud authorized redirect + PUBLIC_APP_URL / web production origin.
# EXPO_PUBLIC_APP_ORIGIN=https://musicpromoai.site
