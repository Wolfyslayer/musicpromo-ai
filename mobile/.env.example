# Mirror web VITE_SUPABASE_* — never commit real secrets.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Same Web OAuth client as web VITE_GOOGLE_CLIENT_ID (optional but preferred).
# When set, native uses Google id_token → supabase.auth.signInWithIdToken.
# When unset, falls back to supabase.auth.signInWithOAuth (add musicpromoai://auth/callback
# to Supabase Authentication → URL configuration → Redirect URLs).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
