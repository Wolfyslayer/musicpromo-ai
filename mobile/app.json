{
  "expo": {
    "name": "MusicPromo AI",
    "slug": "musicpromo-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musicpromoai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.musicpromoai.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload album artwork for promo campaigns.",
        "NSMicrophoneUsageDescription": "Not required for playback-only audio preview.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c0a12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "site.musicpromoai.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0c0a12"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MusicPromo AI to access photos for album artwork."
        }
      ],
      "expo-audio",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
